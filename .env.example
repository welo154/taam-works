# Canonical public origin (metadataBase, sitemap.xml, robots.txt, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.taamworks.com

# Temporary homepage-only gate. Defaults on for Vercel production.
# NEXT_PUBLIC_COMING_SOON=1
# NEXT_PUBLIC_COMING_SOON=0

# Public site talks to the TAAM Works backend (admin + published projects).
TAAM_API_URL=http://localhost:3100
TAAM_ADMIN_URL=http://localhost:3100/admin

# Used only to resolve relative Storage paths returned by the API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
